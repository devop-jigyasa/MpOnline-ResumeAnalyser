<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MPOnline ResumeAnalyser</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="badge rounded-3 me-2 p-2 text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);">
                        <i class="bi bi-file-earmark-person-fill fs-5"></i>
                    </span>
                    <span class="fs-4 text-white">MPOnline <span class="text-gradient">ResumeAnalyser</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1 text-primary"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="JobMatch">
                                <i class="bi bi-bullseye me-1 text-info"></i> Job Matcher
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1 text-success"></i> Privacy
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="badge bg-dark border border-secondary text-light px-3 py-2 rounded-pill me-2">
                                <i class="bi bi-person-circle text-primary me-1"></i> @User.Identity.Name
                            </span>
                            <a class="btn btn-outline-danger btn-sm rounded-pill px-3" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Auth" asp-action="Login">Login</a>
                            <a class="btn btn-brand btn-sm rounded-pill px-4" asp-controller="Auth" asp-action="Register">Get Started</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <footer class="footer bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            <p class="mb-1 fw-semibold text-dark">&copy; 2026 MPOnline ResumeAnalyser &bull; Enterprise ATS Intelligence Platform</p>
            <p class="mb-0 text-secondary">Powered by Google Gemini 3.6 Flash &bull; Cloud & Docker Ready</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
