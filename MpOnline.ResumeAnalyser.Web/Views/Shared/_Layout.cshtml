<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MPOnline ResumeAnalyser</title>
    <!-- Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 ambient-bg">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark glass-dark border-0 rounded-0 py-3 shadow-lg">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="p-2 rounded-3 me-2 text-white" style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%); box-shadow: 0 0 15px rgba(79, 70, 229, 0.5);">
                        <i class="bi bi-cpu-fill fs-5"></i>
                    </span>
                    <span class="fs-4 tracking-tight text-white">MPOnline <span class="text-gradient-primary fw-extrabold">ResumeAnalyser</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-slate-200 fw-medium d-flex align-items-center" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2 text-indigo-400"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-slate-200 fw-medium d-flex align-items-center" asp-controller="Home" asp-action="JobMatch">
                                <i class="bi bi-bullseye me-2 text-cyan"></i> Job Matcher
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 rounded-pill text-slate-200 fw-medium d-flex align-items-center" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock me-2 text-emerald"></i> Security & Privacy
                            </a>
                        </li>
                    </ul>

                    <!-- Right Status & Auth Items -->
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-slate-800 text-slate-300 border border-slate-700 px-3 py-2 rounded-pill d-none d-md-inline-flex align-items-center small">
                            <span class="spinner-grow spinner-grow-sm text-success me-2" role="status" style="width: 8px; height: 8px;"></span>
                            Gemini 3.6 Flash Active
                        </span>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-dark border border-slate-700 rounded-pill px-3 py-2 text-slate-200 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle text-indigo-400 fs-5"></i>
                                    <span class="fw-semibold">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-2 border border-slate-200">
                                    <li><span class="dropdown-item-text small text-muted">Role: Evaluator</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger rounded-3" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 fw-semibold" asp-controller="Auth" asp-action="Login">Sign In</a>
                                <a class="btn btn-gradient-primary btn-sm rounded-pill px-4 py-2" asp-controller="Auth" asp-action="Register">Get Started</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Global Toast Container -->
    <div id="copyToast" class="toast align-items-center text-bg-dark border-0 rounded-4 shadow-lg p-1" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                <span id="toastMessage">Copied to clipboard!</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>

    <footer class="footer bg-white border-top py-4 mt-auto">
        <div class="container text-center text-muted small">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <p class="mb-0 fw-semibold text-slate-700">&copy; 2026 MPOnline ResumeAnalyser &bull; Enterprise ATS Intelligence</p>
                    <p class="mb-0 text-slate-400 small">Google Gemini GenAI Engine &bull; Memory-Safe PdfPig &bull; Docker & Cloud Ready</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="badge bg-slate-100 text-slate-600 border px-3 py-2 rounded-pill me-2">
                        <i class="bi bi-shield-check text-success me-1"></i> Zero Disk Storage
                    </span>
                    <span class="badge bg-slate-100 text-slate-600 border px-3 py-2 rounded-pill">
                        <i class="bi bi-check-circle-fill text-primary me-1"></i> v1.0.0
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function showGlobalToast(msg) {
            const toastEl = document.getElementById('copyToast');
            if (toastEl) {
                document.getElementById('toastMessage').innerText = msg;
                const toast = new bootstrap.Toast(toastEl, { delay: 2500 });
                toast.show();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
