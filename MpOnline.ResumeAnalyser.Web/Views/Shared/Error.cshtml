@model MpOnline.ResumeAnalyser.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto rounded-4" style="max-width: 600px;">
        <div class="fs-1 text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <h2 class="fw-bold mb-3">Something Went Wrong</h2>
        <p class="text-muted">An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <div class="alert alert-secondary py-2 small">Request ID: <code>@Model.RequestId</code></div>
        }
        <a asp-action="Index" class="btn btn-primary rounded-pill mt-3 px-4">Back to Dashboard</a>
    </div>
</div>
