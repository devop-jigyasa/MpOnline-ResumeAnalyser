@{
    ViewData["Title"] = "Job Description Matcher";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-indigo-600 text-white rounded-pill px-3 py-2 mb-3">
            <i class="bi bi-crosshair me-1"></i> Smart Match Engine
        </span>
        <h2 class="display-5 fw-extrabold text-slate-900 tracking-tight">Job Fit & Gap Analyzer</h2>
        <p class="lead text-slate-600 mx-auto" style="max-width: 650px;">
            Cross-reference your resume directly against the target job posting to uncover missing technical skills, keyword gaps, and tailored advice.
        </p>
    </div>

    <form asp-controller="Home" asp-action="AnalyzeJobMatch" method="post" enctype="multipart/form-data">
        <div class="row g-4 mb-4">
            <!-- Left Panel: Resume File -->
            <div class="col-lg-5">
                <div class="glass-panel p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-danger-subtle text-danger rounded-circle p-2 fs-5"><i class="bi bi-file-earmark-pdf"></i></span>
                        <div>
                            <h5 class="fw-bold mb-0 text-slate-900">1. Upload Candidate Resume</h5>
                            <span class="text-slate-500 small">Target candidate document</span>
                        </div>
                    </div>

                    <div class="dropzone-container flex-grow-1 d-flex flex-column align-items-center justify-content-center p-4">
                        <input type="file" id="jmFileInput" name="resumeFile" class="form-control" accept=".pdf,.docx" required />
                        <div class="mt-3 text-slate-500 small">
                            <i class="bi bi-shield-check text-emerald me-1"></i> Memory-buffered text extraction
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Job Description -->
            <div class="col-lg-7">
                <div class="glass-panel p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary-light text-primary rounded-circle p-2 fs-5"><i class="bi bi-card-text"></i></span>
                            <div>
                                <h5 class="fw-bold mb-0 text-slate-900">2. Target Job Description</h5>
                                <span class="text-slate-500 small">Paste job specifications and criteria</span>
                            </div>
                        </div>
                        <button type="button" id="samplePromptBtn" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            <i class="bi bi-magic me-1"></i> Paste Sample
                        </button>
                    </div>

                    <textarea id="jobDescArea" name="jobDescription" class="form-control flex-grow-1 rounded-4 p-3 border" rows="9" 
                              placeholder="Paste the full job description here (responsibilities, required tech stack, nice-to-haves)..." required></textarea>
                </div>
            </div>
        </div>

        <div class="text-center">
            <button type="submit" id="jmSubmitBtn" class="btn btn-gradient-primary btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg">
                <i class="bi bi-lightning-charge-fill me-2"></i>Compute Alignment & Gap Analysis
            </button>
        </div>

        <!-- Progress Spinner -->
        <div id="loading-spinner" class="d-none text-center py-4">
            <div class="pulse-scanner-ring">
                <i class="bi bi-crosshair text-primary fs-2"></i>
            </div>
            <h5 class="fw-bold text-slate-900 mb-1" id="loading-text">Extracting target qualifications...</h5>
            <p class="text-slate-500 small">Cross-referencing candidate keywords against job requirements...</p>
        </div>
    </form>
</div>

<script>
    document.getElementById('samplePromptBtn')?.addEventListener('click', function() {
        const sample = `We are seeking a Senior .NET Backend Developer with experience in:
- C#, ASP.NET Core Web API, and Entity Framework Core
- Cloud technologies (AWS/Azure) and Docker containerization
- RESTful API design, CI/CD with GitHub Actions
- Microservices, asynchronous messaging, and SQL Database optimization.`;
        document.getElementById('jobDescArea').value = sample;
    });

    document.querySelector('form')?.addEventListener('submit', function() {
        const btn = document.getElementById('jmSubmitBtn');
        const spinner = document.getElementById('loading-spinner');
        const text = document.getElementById('loading-text');

        if (btn) btn.classList.add('d-none');
        if (spinner) spinner.classList.remove('d-none');

        setTimeout(() => { if (text) text.innerText = "Computing semantic skill similarity..."; }, 1500);
        setTimeout(() => { if (text) text.innerText = "Synthesizing gap mitigation suggestions..."; }, 3500);
    });
</script>
