@{
    ViewData["Title"] = "ATS Intelligence Portal";
}

<!-- Hero Section with Floating Badges -->
<div class="py-5 position-relative">
    <div class="container py-4 text-center">
        <!-- Ambient Top Badge -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white border border-indigo-200 shadow-sm mb-4">
            <span class="badge rounded-pill bg-indigo-600 text-white"><i class="bi bi-stars"></i> Next-Gen</span>
            <span class="small fw-semibold text-slate-700">Zero-Shot ATS Evaluation Engine powered by Gemini 3.6 Flash</span>
        </div>

        <h1 class="display-3 fw-extrabold text-slate-900 mb-3 tracking-tight">
            Stop Guessing. <br class="d-none d-md-block" />
            Beat the ATS with <span class="text-gradient-primary">Explainable AI</span>.
        </h1>
        
        <p class="lead text-slate-600 mx-auto mb-5" style="max-width: 720px; font-size: 1.25rem;">
            Upload your resume to get instant deterministic ATS scores, keyword substantiation audit, and personalized coaching metrics before recruiters filter you out.
        </p>

        <!-- Floating Chips Display -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
            <span class="badge bg-white text-slate-700 border px-3 py-2 rounded-pill shadow-sm floating-chip" style="animation-delay: 0s;">
                <i class="bi bi-shield-check text-emerald me-1"></i> Anti-Keyword Stuffing Engine
            </span>
            <span class="badge bg-white text-slate-700 border px-3 py-2 rounded-pill shadow-sm floating-chip" style="animation-delay: 1.5s;">
                <i class="bi bi-lightning-charge text-amber me-1"></i> Deterministic Scoring Matrix
            </span>
            <span class="badge bg-white text-slate-700 border px-3 py-2 rounded-pill shadow-sm floating-chip" style="animation-delay: 2.5s;">
                <i class="bi bi-lock text-cyan me-1"></i> 100% In-Memory Safe Parsing
            </span>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Interactive Upload Box -->
            <div class="glass-panel p-4 p-md-5 mx-auto text-start" style="max-width: 650px;">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h4 class="fw-bold mb-1 text-slate-900"><i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>Analyze Candidate Resume</h4>
                        <p class="text-slate-500 small mb-0">Supported formats: PDF, DOCX (Max 5MB)</p>
                    </div>
                    <span class="badge bg-primary-light text-primary border border-primary px-3 py-2 rounded-pill small">
                        In-Memory Stream
                    </span>
                </div>

                <form id="resumeUploadForm" asp-controller="Home" asp-action="Upload" method="post" enctype="multipart/form-data">
                    <!-- Modern Drag & Drop Zone -->
                    <div id="dropZone" class="dropzone-container mb-4">
                        <input type="file" id="resumeFileInput" name="resumeFile" class="d-none" accept=".pdf,.docx" required />
                        
                        <div id="dropzonePrompt">
                            <div class="dropzone-icon">
                                <i class="bi bi-cloud-arrow-up"></i>
                            </div>
                            <h5 class="fw-bold text-slate-800 mb-1">Drag & Drop Resume Here</h5>
                            <p class="text-slate-500 small mb-3">or <span class="text-primary fw-bold text-decoration-underline">browse file from your device</span></p>
                            <span class="badge bg-white border text-slate-600 px-3 py-1 rounded-pill small">
                                <i class="bi bi-filetype-pdf text-danger me-1"></i> PDF Recommended
                            </span>
                        </div>

                        <!-- Selected File Preview Container -->
                        <div id="fileSelectedPreview" class="d-none text-center py-2">
                            <div class="d-inline-flex align-items-center gap-3 p-3 bg-white rounded-4 border shadow-sm">
                                <i class="bi bi-file-earmark-pdf-fill text-danger fs-1"></i>
                                <div class="text-start">
                                    <h6 class="fw-bold mb-0 text-slate-800" id="previewFileName">filename.pdf</h6>
                                    <span class="text-muted small" id="previewFileSize">240 KB</span>
                                </div>
                                <button type="button" id="removeFileBtn" class="btn btn-outline-danger btn-sm rounded-circle p-2 ms-2" title="Remove file">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-gradient-primary btn-lg w-100 rounded-pill py-3 fw-bold">
                        <i class="bi bi-cpu-fill me-2"></i>Run ATS Deep Analysis
                    </button>
                </form>

                <!-- Futuristic Multi-Stage AI Scanner -->
                <div id="loading-spinner" class="d-none text-center py-4">
                    <div class="pulse-scanner-ring">
                        <i class="bi bi-cpu text-primary fs-2"></i>
                    </div>
                    <h5 class="fw-bold text-slate-900 mb-2" id="loading-stage-title">Deconstructing Resume Layers</h5>
                    <p class="text-slate-500 small mb-4" id="loading-stage-desc">PdfPig is extracting in-memory AST text blocks without disk footprint...</p>

                    <!-- Step-by-Step Progress Dots -->
                    <div class="d-flex justify-content-center gap-2">
                        <span id="step1" class="badge bg-primary px-3 py-1 rounded-pill">1. PdfPig Parser</span>
                        <span id="step2" class="badge bg-slate-200 text-slate-600 px-3 py-1 rounded-pill">2. Heuristic Audit</span>
                        <span id="step3" class="badge bg-slate-200 text-slate-600 px-3 py-1 rounded-pill">3. Gemini AI</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- CTA for visitors -->
            <div class="glass-panel p-5 mx-auto text-center" style="max-width: 650px;">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-unlock-fill"></i></div>
                <h3 class="fw-bold text-slate-900 mb-2">Ready to evaluate your resume?</h3>
                <p class="text-slate-600 mb-4">Sign in to evaluate documents, test against job descriptions, and generate interview questions.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-gradient-primary btn-lg px-5 py-3 rounded-pill">
                        Sign In with Demo Account <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
                <div class="mt-4 p-3 bg-slate-100 rounded-4 text-slate-600 small">
                    <i class="bi bi-info-circle-fill text-primary me-1"></i> Demo login: <code>admin@mponline.gov.in</code> / <code>admin123</code>
                </div>
            </div>
        }
    </div>
</div>

<!-- Interactive Feature Grid -->
<div class="container pb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="glass-panel h-100 p-4 p-lg-5">
                <div class="p-3 d-inline-flex rounded-4 bg-primary-light text-primary mb-3 fs-2">
                    <i class="bi bi-bar-chart-steps"></i>
                </div>
                <h4 class="fw-bold mb-2">ATS Scoring Engine</h4>
                <p class="text-slate-600 small">Evaluates keyword density, layout parsability, and structural completeness against modern recruitment portals.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 p-4 p-lg-5">
                <div class="p-3 d-inline-flex rounded-4 text-emerald mb-3 fs-2" style="background: rgba(16, 185, 129, 0.1);">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h4 class="fw-bold mb-2">Substantiation Engine</h4>
                <p class="text-slate-600 small">Cross-references listed technical proficiencies against actual project experience and quantitative achievements.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel h-100 p-4 p-lg-5">
                <div class="p-3 d-inline-flex rounded-4 text-cyan mb-3 fs-2" style="background: rgba(6, 182, 212, 0.1);">
                    <i class="bi bi-lightbulb-fill"></i>
                </div>
                <h4 class="fw-bold mb-2">Explainable AI Rationale</h4>
                <p class="text-slate-600 small">Delivers transparent scoring rationales and actionable coaching recommendations without black-box bias.</p>
            </div>
        </div>
    </div>
</div>

<!-- Script for Drag & Drop + File Preview -->
<script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('resumeFileInput');
    const promptBox = document.getElementById('dropzonePrompt');
    const previewBox = document.getElementById('fileSelectedPreview');
    const previewName = document.getElementById('previewFileName');
    const previewSize = document.getElementById('previewFileSize');
    const removeBtn = document.getElementById('removeFileBtn');
    const form = document.getElementById('resumeUploadForm');

    if (dropZone && fileInput) {
        dropZone.addEventListener('click', (e) => {
            if (e.target !== removeBtn && !removeBtn?.contains(e.target)) {
                fileInput.click();
            }
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('dragover');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                updateFilePreview();
            }
        });

        fileInput.addEventListener('change', updateFilePreview);

        removeBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            fileInput.value = '';
            promptBox.classList.remove('d-none');
            previewBox.classList.add('d-none');
        });

        function updateFilePreview() {
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                if (file.size > 5 * 1024 * 1024) {
                    alert("File size exceeds 5MB limit. Please choose a smaller document.");
                    fileInput.value = '';
                    return;
                }
                previewName.innerText = file.name;
                previewSize.innerText = (file.size / 1024).toFixed(1) + ' KB';
                promptBox.classList.add('d-none');
                previewBox.classList.remove('d-none');
            }
        }
    }

    if (form) {
        form.addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            const dropzone = document.getElementById('dropZone');
            const spinner = document.getElementById('loading-spinner');
            const title = document.getElementById('loading-stage-title');
            const desc = document.getElementById('loading-stage-desc');
            const s1 = document.getElementById('step1');
            const s2 = document.getElementById('step2');
            const s3 = document.getElementById('step3');

            submitBtn.classList.add('d-none');
            dropzone.classList.add('d-none');
            spinner.classList.remove('d-none');

            setTimeout(() => {
                if (title) title.innerText = "Running ATS Heuristic Checks...";
                if (desc) desc.innerText = "Analyzing layout hierarchy, keyword density, and contact detection...";
                s1?.classList.replace('bg-primary', 'bg-success');
                s2?.classList.replace('bg-slate-200', 'bg-primary');
                s2?.classList.remove('text-slate-600');
                s2?.classList.add('text-white');
            }, 1400);

            setTimeout(() => {
                if (title) title.innerText = "Querying Gemini 3.6 Flash...";
                if (desc) desc.innerText = "Evaluating skill claims against project metrics & synthesizing score rationale...";
                s2?.classList.replace('bg-primary', 'bg-success');
                s3?.classList.replace('bg-slate-200', 'bg-primary');
                s3?.classList.remove('text-slate-600');
                s3?.classList.add('text-white');
            }, 3200);
        });
    }
</script>
