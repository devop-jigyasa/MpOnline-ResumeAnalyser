@{
    ViewData["Title"] = "AI-Powered Resume Intelligence";
}

<!-- Hero Section -->
<div class="hero-gradient-bg py-5 text-center mb-5">
    <div class="container py-4">
        <span class="badge bg-indigo-100 text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-3 shadow-sm" style="background-color: #eef2ff;">
            <i class="bi bi-stars me-1 text-primary"></i> Next-Gen Career Intelligence
        </span>
        <h1 class="display-4 fw-bold text-dark mb-3">
            Optimize Your Resume with <span class="text-gradient">Gemini AI</span>
        </h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 680px;">
            Harness real-time ATS scoring, keyword verification, explainable AI rationale, and intelligent job description matching.
        </p>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <!-- Clean Elevated Upload Box -->
            <div class="card card-modern mx-auto p-4 p-md-5 text-start" style="max-width: 560px;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-arrow-up text-primary me-2"></i>Analyze Your Resume
                    </h5>
                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">PDF, DOCX</span>
                </div>

                <form asp-controller="Home" asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" name="resumeFile" class="form-control form-control-lg rounded-3" accept=".pdf,.docx" required />
                    </div>
                    <button type="submit" id="submitBtn" class="btn btn-brand btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Run ATS Analysis
                    </button>
                </form>

                <!-- Clean Spinner -->
                <div id="loading-spinner" class="d-none text-center mt-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <h6 class="mt-2 fw-bold text-secondary" id="loading-text">Extracting PDF text structures...</h6>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Auth" asp-action="Login" class="btn btn-brand btn-lg px-5 py-3 rounded-pill fw-bold shadow-sm">
                    Get Started Free <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-pill">
                    Create Account
                </a>
            </div>
        }
    </div>
</div>

<!-- 3 Feature Cards (Original Clean Layout with Beautiful Colors) -->
<div class="container pb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card card-modern h-100 p-4 rounded-4">
                <div class="icon-box icon-box-indigo mx-auto">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h5 class="fw-bold text-dark">ATS Scoring Engine</h5>
                <p class="text-muted small mb-0">Evaluates keyword density, layout parsability, and structural completeness against modern ATS standards.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-modern h-100 p-4 rounded-4">
                <div class="icon-box icon-box-emerald mx-auto">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Substantiation Engine</h5>
                <p class="text-muted small mb-0">Cross-verifies listed technical skills against actual project experience and quantitative metrics.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-modern h-100 p-4 rounded-4">
                <div class="icon-box icon-box-amber mx-auto">
                    <i class="bi bi-lightbulb-fill"></i>
                </div>
                <h5 class="fw-bold text-dark">Responsible AI Rationale</h5>
                <p class="text-muted small mb-0">Generates transparent scoring explanations and actionable recommendations without black-box bias.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
            const fileInput = form.querySelector('input[type="file"]');
            const submitBtn = document.getElementById('submitBtn');
            const spinner = document.getElementById('loading-spinner');
            const loadingText = document.getElementById('loading-text');

            if (fileInput && fileInput.files.length > 0) {
                if (fileInput.files[0].size > 5 * 1024 * 1024) {
                    e.preventDefault();
                    alert("File size exceeds 5MB limit. Please upload a smaller file.");
                    return;
                }
            }

            if (submitBtn) submitBtn.classList.add('d-none');
            if (spinner) spinner.classList.remove('d-none');

            if (loadingText) {
                setTimeout(() => loadingText.innerText = "Extracting text nodes with PdfPig...", 1200);
                setTimeout(() => loadingText.innerText = "Querying Gemini AI ATS Evaluation Engine...", 3000);
                setTimeout(() => loadingText.innerText = "Computing score breakdown...", 4800);
            }
        });
    });
</script>
