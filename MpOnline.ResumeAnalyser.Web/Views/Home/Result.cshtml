@model MpOnline.ResumeAnalyser.Web.Models.ResultViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "ATS Analysis Results";

    JsonElement root = default;
    bool isValidJson = false;
    try
    {
        if (!string.IsNullOrWhiteSpace(Model.AiFeedback))
        {
            using var doc = JsonDocument.Parse(Model.AiFeedback);
            root = doc.RootElement.Clone();
            isValidJson = true;
        }
    }
    catch { isValidJson = false; }
}

<div class="container py-4">
    @if (isValidJson)
    {
        var name = root.TryGetProperty("candidate_name", out var n) ? (n.GetString() ?? "Candidate") : "Candidate";
        var role = root.TryGetProperty("target_role", out var r) ? (r.GetString() ?? "Target Role") : "Target Role";
        var score = root.TryGetProperty("overall_ats_score", out var s) ? s.GetInt32() : 0;
        var rationale = root.TryGetProperty("ai_decision_rationale", out var rat) ? (rat.GetString() ?? "Analysis complete.") : "Analysis complete.";

        string badgeClass = score >= 80 ? "bg-success" : score >= 60 ? "bg-warning text-dark" : "bg-danger";

        <!-- Top Header Banner -->
        <div class="card border-0 shadow-sm mb-4 text-white rounded-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
            <div class="card-body p-4 p-md-5 d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <span class="badge bg-primary mb-2 px-3 py-1 rounded-pill"><i class="bi bi-file-earmark-person me-1"></i> Candidate Profile</span>
                    <h2 class="fw-bold mb-1">@name</h2>
                    <p class="mb-0 text-light opacity-75 fs-5"><i class="bi bi-briefcase me-2"></i>@role</p>
                </div>
                <div class="text-center mt-3 mt-md-0">
                    <span class="badge @badgeClass fs-3 px-4 py-3 rounded-pill shadow-sm">
                        ATS Score: @score / 100
                    </span>
                </div>
            </div>
        </div>

        <!-- AI Rationale Alert -->
        <div class="alert alert-info mb-4 border-0 shadow-sm rounded-4 bg-white border-start border-4 border-primary p-4">
            <h6 class="fw-bold text-primary mb-1"><i class="bi bi-lightbulb-fill me-2"></i>AI Decision Rationale:</h6>
            <p class="mb-0 text-secondary" style="font-size: 1.05rem; line-height: 1.6;">@rationale</p>
        </div>

        <div class="row g-4">
            <!-- Detailed Score Breakdown -->
            @if (root.TryGetProperty("score_breakdown", out var breakdown))
            {
                <div class="col-lg-6">
                    <div class="card card-modern h-100 p-4">
                        <div class="border-bottom pb-3 mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Detailed Score Breakdown</h5>
                        </div>
                        <div>
                            @foreach (var prop in breakdown.EnumerateObject())
                            {
                                var label = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(prop.Name.Replace("_", " "));
                                var val = prop.Value.GetInt32();
                                var barColor = val >= 80 ? "bg-success" : val >= 60 ? "bg-warning" : "bg-danger";

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-medium text-secondary">@label</span>
                                        <span class="fw-bold text-dark">@val%</span>
                                    </div>
                                    <div class="progress" style="height: 10px; border-radius: 8px;">
                                        <div class="progress-bar @barColor rounded-pill" role="progressbar" style="width: @val%" aria-valuenow="@val" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- ATS Parsability Checklist -->
            @if (root.TryGetProperty("ats_parsability_analysis", out var parsability))
            {
                <div class="col-lg-6">
                    <div class="card card-modern h-100 p-4">
                        <div class="border-bottom pb-3 mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-check2-circle text-success me-2"></i>ATS Parsability Checklist</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var prop in parsability.EnumerateObject())
                            {
                                var itemLabel = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(prop.Name.Replace("_", " "));
                                var isOk = prop.Value.ValueKind == JsonValueKind.True || (prop.Value.ValueKind == JsonValueKind.String && prop.Value.GetString()?.ToLower() == "true");

                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 bg-transparent">
                                    <span class="text-secondary fw-medium">@itemLabel</span>
                                    @if (isOk)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-lg me-1"></i> Detected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-x-lg me-1"></i> Check Needed
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Recommended Improvements -->
            @if (root.TryGetProperty("improvement_suggestions", out var suggestions) && suggestions.GetArrayLength() > 0)
            {
                <div class="col-lg-6">
                    <div class="card card-modern h-100 p-4">
                        <div class="border-bottom pb-3 mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-arrow-up-right-circle text-primary me-2"></i>Recommended Improvements</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in suggestions.EnumerateArray())
                            {
                                <li class="list-group-item border-0 px-0 py-2 text-secondary bg-transparent d-flex align-items-start">
                                    <i class="bi bi-chevron-right text-primary me-2 mt-1"></i>
                                    <span>@item.GetString()</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Unsubstantiated Skills -->
            @if (root.TryGetProperty("unsubstantiated_skills", out var unsubstantiated) && unsubstantiated.GetArrayLength() > 0)
            {
                <div class="col-lg-6">
                    <div class="card card-modern h-100 p-4 border-start border-4 border-warning">
                        <div class="border-bottom pb-3 mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Unsubstantiated Skills Flagged</h5>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var item in unsubstantiated.EnumerateArray())
                            {
                                <li class="list-group-item border-0 px-0 py-2 text-secondary bg-transparent d-flex align-items-start">
                                    <i class="bi bi-exclamation-circle text-warning me-2 mt-1"></i>
                                    <span>@item.GetString()</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-action="Index" class="btn btn-brand btn-lg px-5 py-2 rounded-pill shadow-sm me-2">
                <i class="bi bi-arrow-repeat me-2"></i>Upload Another Resume
            </a>
            <button onclick="window.print()" class="btn btn-outline-dark btn-lg px-5 py-2 rounded-pill shadow-sm">
                <i class="bi bi-printer me-2"></i>Export AI Report
            </button>
        </div>
    }
    else
    {
        <!-- Markdown Output for Job Matcher -->
        <div class="card card-modern p-4 p-md-5">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-file-text text-primary me-2"></i>Job Match Analysis</h4>
            <div id="raw-markdown" class="d-none">@Model.AiFeedback</div>
            <div id="formatted-output" class="bg-light p-4 rounded-4" style="font-size: 1.05rem; line-height: 1.7;"></div>
            <div class="text-center mt-4">
                <a asp-action="JobMatch" class="btn btn-outline-primary rounded-pill px-4 me-2">Analyze Another Job</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Upload New Resume</a>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var rawText = document.getElementById('raw-markdown').innerText;
                document.getElementById('formatted-output').innerHTML = marked.parse(rawText);
            });
        </script>
    }
</div>
